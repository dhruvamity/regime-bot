# Copy to .env and fill in. Never share this file.
# 1) In Telegram, message @BotFather -> /newbot -> copy the token it gives you here.
TELEGRAM_BOT_TOKEN=
# 2) Optional: comma-separated chat ids allowed to use the bot. Leave empty and the first
#    chat that sends /start becomes the owner (everyone else is refused).
TELEGRAM_ALLOWED_CHATS=
# Alerts inside this window (IST) are delivered silently. Empty = always loud.
QUIET_HOURS_IST=01:00-08:00
# Daily "should I trade today?" brief (IST, Mon-Fri). Empty = off.
BRIEF_TIME_IST=12:00
